VITE_TRACK_ENDPOINT=

# Google Tag Manager (Etapa 7). Deixe em branco para desativar o snippet.
VITE_GTM_ID=

# URL do checkout externo (último CTA do quiz — Etapa 5).
VITE_CHECKOUT_URL=https://example.com/checkout
