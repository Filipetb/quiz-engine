# Supabase — do `supabase start` (local) ou do painel Cloud (produção).
VITE_SUPABASE_URL=http://127.0.0.1:54341
VITE_SUPABASE_ANON_KEY=

# URL da edge function de ingestão de eventos (Etapa 7).
